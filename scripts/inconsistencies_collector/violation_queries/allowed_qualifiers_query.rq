PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

SELECT
  ?subject
  ?wd_property
  ?SQ
  ?Q
WHERE
{
  ?CQ ps:P2302 wd:Q21510851. ## allowed qualifiers constraints
  ?wd_property p:P2302 ?CQ.
  ?wd_property wikibase:claim ?PSQ.
  
  ?subject ?PSQ ?SQ.
  ?SQ ?Q [].
  ?wd_qualifier wikibase:qualifier ?Q.
  FILTER NOT EXISTS {?CQ pq:P2306 ?wd_qualifier}
   
  # exception and deprecation
  FILTER NOT EXISTS {?CQ pq:P2241 []}
  FILTER NOT EXISTS {?CQ wikibase:rank wikibase:DeprecatedRank}
  FILTER NOT EXISTS {?CQ pq:P2303 ?subject}

  # EXAMPLE (comment next line to query all violations for all properties of this type...)
  # ... however note the risk of timeout: we suggest to run these queries one by one for each property of this type
  #FILTER (?PSQ = p:P210)
}
