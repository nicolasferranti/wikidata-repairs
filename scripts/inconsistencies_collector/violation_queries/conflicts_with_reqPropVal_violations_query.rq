PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

SELECT
?subject
?property # main property
?PC # conflicting property
?VC # optional conflicting object 
WHERE
{
  ?property wikibase:directClaim ?P.
  ?property p:P2302 ?CQ.
  ?CQ ps:P2302 wd:Q21502838. ## conflicts-with constraint
  ?CQ pq:P2306/wikibase:directClaim ?PC .
  
  # WITH FORBIDDEN VALUE
  ?CQ pq:P2305 ?VC.
  
  ?subject ?P ?object.
  ?subject ?PC ?VC.
  
  # exception and deprecation
  FILTER NOT EXISTS {?CQ pq:P2241 []}
  FILTER NOT EXISTS {?CQ wikibase:rank wikibase:DeprecatedRank}
  FILTER NOT EXISTS {?CQ pq:P2303 ?subject}
  
}
