PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX p: <http://www.wikidata.org/prop/>
PREFIX pq: <http://www.wikidata.org/prop/qualifier/>
PREFIX ps: <http://www.wikidata.org/prop/statement/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

SELECT 
?subject ?property ?PC
{
  ?property wikibase:directClaim ?P.
  ?property p:P2302 ?CQ.
  ?CQ ps:P2302 wd:Q21503247. ## item-requires-statement constraint
  ?CQ pq:P2306/wikibase:directClaim ?PC.
  ?CQ pq:P2305 [].

  ?subject ?P [].
  # exception and deprecation
  FILTER NOT EXISTS {?CQ pq:P2241 []}
  FILTER NOT EXISTS {?CQ wikibase:rank wikibase:DeprecatedRank}
  FILTER NOT EXISTS {?CQ pq:P2303 ?subject} 
  FILTER NOT EXISTS { 
    ?subject ?PC ?VC. 
    ?CQ pq:P2305 ?VC.
  } 
}
